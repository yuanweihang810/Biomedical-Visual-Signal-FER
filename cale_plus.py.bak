# paper2/cale_plus.py
import math
import torch
import torch.nn as nn
import torch.nn.functional as F
from torchvision import models


class ConditionSpecificTransform:
    """mode='cond': 条件特定对比度拉伸（默认）
       mode='rand': 每分支固定随机几何变换（旋转 0/90/180/270 度）"""
    def __init__(self, lam=20.0, low_res_scale=0.3, mode='cond'):
        self.lam = lam
        self.low_res_scale = low_res_scale
        self.mode = mode

    def _rotate(self, x, degrees):
        import torchvision.transforms.functional as TF
        return TF.rotate(x, degrees)

    def __call__(self, x, c):
        if self.mode == 'rand':
            return self._rotate(x, [0, 90, 180, 270][c])
        # mode='cond'
        if c == 0:
            return torch.log1p(self.lam * x) / math.log(1 + self.lam)
        elif c == 1:
            return 1.0 - torch.log1p(self.lam * (1 - x)) / math.log(1 + self.lam)
        elif c == 2:
            h, w = x.shape[-2:]
            down = F.interpolate(x, scale_factor=self.low_res_scale,
                                 mode='bilinear', align_corners=False)
            up = F.interpolate(down, size=(h, w),
                               mode='bilinear', align_corners=False)
            return up
        else:
            return x


def create_backbone(name='resnet18', pretrained=True):
    if name == 'resnet18':
        m = models.resnet18(weights='IMAGENET1K_V1' if pretrained else None)
        fd = m.fc.in_features; m.fc = nn.Identity()
    elif name == 'resnet34':
        m = models.resnet34(weights='IMAGENET1K_V1' if pretrained else None)
        fd = m.fc.in_features; m.fc = nn.Identity()
    elif name == 'resnet50':
        m = models.resnet50(weights='IMAGENET1K_V1' if pretrained else None)
        fd = m.fc.in_features; m.fc = nn.Identity()
    elif name == 'mobilenetv2':
        m = models.mobilenet_v2(weights='IMAGENET1K_V1' if pretrained else None)
        fd = m.classifier[-1].in_features; m.classifier = nn.Identity()
    elif name == 'efficientnet_b0':
        m = models.efficientnet_b0(weights='IMAGENET1K_V1' if pretrained else None)
        fd = m.classifier[-1].in_features; m.classifier = nn.Identity()
    else:
        raise ValueError(name)
    return m, fd


class CALEPlus(nn.Module):
    """
    K=1: 单分支 baseline（无变换，直接前向）
    K=4: 多分支 + 条件特定增强，聚合 = 平均 logits
    """
    def __init__(self, backbone_name='resnet18', K=4, E=7, use_transform=True, transform_mode='cond'):
        super().__init__()
        self.K, self.E = K, E
        self.use_transform = use_transform
        self.backbone, feat_dim = create_backbone(backbone_name)
        self.branch_heads = nn.ModuleList([nn.Linear(feat_dim, E) for _ in range(K)])
        self.transform = ConditionSpecificTransform(mode=transform_mode)
        self.register_buffer('imagenet_mean',
                             torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))
        self.register_buffer('imagenet_std',
                             torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))
        self.use_imagenet_norm = True

    def forward(self, x):
        logits_list = []
        for k in range(self.K):
            x_k = self.transform(x, k) if self.use_transform else x
            feat = self.backbone(x_k)
            logits_list.append(self.branch_heads[k](feat))
        logits = torch.stack(logits_list, dim=1)  # [B, K, E]
        p = logits.mean(dim=1)                    # [B, E] 简单平均聚合
        return p, logits
